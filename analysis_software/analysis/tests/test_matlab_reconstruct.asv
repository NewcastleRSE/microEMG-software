% Updated agin for use by RH when developing Python version of Reconstruct.m
% GS's slight modifications to localise_real_data.m script to 
%   1) work with sample data provided by SM on 16 Nov. 2023
%   2) provide a different output folder for saving processed data so 
%       original data is not overwritten
%   3) provide notes on sample data
%   4) time different steps
%
% Beyond changing directories and updating settings using available
% config.mat info, code has not been changed. See commit history for exact
% changes.
%
% 17 November 2023

%% Working recordings
% forcedata/BA_RVI_EMG2_48CH-02_Left Bicep_27_03_2015
% forcedata/combined
% forcedata/EE_LTA_RVI_1
% forcedata/MVC10_1
% forcedata/Stuart_E2

%% GS: clear workspace and cd to local multi-emg repo

close all; clearvars; clc

% multi-emg repo (change to your path or manually navigate to it and 
% add to MATLAB path) 
%home_dir = strjoin({'/Users','Gabrielle','Documents','RSE_gabrielle',...
%    'microEMG','original_code','multi-emg'},'/');

% add to path
%addpath(genpath(home_dir))

% cd
%cd(home_dir)
%clearvars home_dir

%% GS: available data to analyse

% Directory within multi-emg that contains set of recordings (sent by SM, 
% originally lablled "Archive"). Current path is
%       multi-emg > sample_data_20231116 > original_data
%
% Each subfolder contains a different recording, except for "forcedata".
% "forcedata" folder contains an additional set of folders, each
% corresponding to a different recording. 
data_dir = strjoin(...
    {'data','sample_data_20231116','original_data'},...
    '/');

% all subfolders
data_subdir_all = struct2table(dir(data_dir));
data_subdir_all = data_subdir_all.name(4:end)
% ignore __MACOSX

% subfolders:
%     {'BA_LTA_RVI_1'}
%     {'Current'     }
%     {'EE_LTA_RVI_2'}
%     {'EE_LTA_RVI_3'}
%     {'EE_LTA_RVI_4'}
%     {'Stuart_E2'   }
%     {'__MACOSX'    }
%     {'force'       }
%     {'forcedata'   }
    
% forcedata subfolders:
%     {'BA_RVI_EMG2_48CH-02_Left Bicep_27_03_2015- rating = 7'}
%     {'EE_LTA_RVI_1- rating = 6'                             }
%     {'IncreasedForceData-Stuart_1'                          }
%     {'MVC10_1'                                              }
%     {'MVC20_1'                                              }
%     {'MVC50_1'                                              }
%     {'Stuart_E2'                                            }
%     {'combined'                                             }


% Data notes:
%
% Notes:
%
% Of the recordings in top level folder (not forcedata):
%  - folders with raw .dat files: 
%       - 'BA_LTA_RVI_1'
%       - 'EE_LTA_RVI_2'
%       - 'EE_LTA_RVI_3'
%       - 'EE_LTA_RVI_4'
%       - 'Stuart_E2'
%  - 'Current', 'force' only have hpFiltered folder that is compatible with
%  this script
%  - folders with config.mat: 'Stuart_E2', 'force' (but possible some of 
%  forcedata subfolders may have matching config.mat? some folder names are
%   the same)
%  - 'force' is the only config.mat with non-empty broken channels field
%  (also no labelled broken channels in forcedata subfolders)
%  - what are designFilt folders? older version of hpFiltered?
%
%
% "forcedata" recordings:
%
% - None of the folders contain raw data; instead, they contain (some) of 
% the preprocessed files.

%% GS: choose subfolder to analyse
% script current works with recordings that have .dat files 

data_subdir = 'Stuart_E2';
clearvars data_subdir_all

%% Code

% GS: different ouptut directory so new files are separate from raw/processed
% data sent by SM
data_output_root=strjoin(...
    {'data','sample_data_20231116','analysis_output',data_subdir},...
    '/');
mkdir(data_output_root)
raw_dir = [data_dir '/' data_subdir '/raw']; 
in_dir = [data_output_root, '/import'];
mains_dir=[data_output_root, '/nomains'];
out_dir=[data_output_root, '/hpFiltered'];
common_dir = [data_output_root, '/noCommon'];

%% Analysis settings

% default settings
settings = make_settings();
settings.n_electrodes = 32; % need to check if this number is correct for the recordings without config.mat files
settings.broken_channels = [];
settings.mavg_length = 1;
settings.trigger_channel = 0;

% GMS: add config metadata if available
switch data_subdir
    case 'Stuart_E2'
        load([data_dir '/' data_subdir '/config.mat'])
        
        settings.broken_channels = config.broken;
        settings.n_electrodes = config.channels;
        
        clearvars config
    otherwise
        error('recording file not specified - check if file has config.mat metadata')
end

%% Preprocessing
% Noted times are using Stuart_E2 with 64 channels on an Apple M2 Pro Mac
% with Matlab R2021a (designed for Intel chip)
disp("Reading raw data...")
tic
readData(raw_dir, 20000, settings.n_electrodes, in_dir);
toc
disp("Read raw data")

% ~4 seconds
% (4 seconds on R2023b)
%%
disp("Removing mains...")
tic
removemains(20000,51,settings.n_electrodes, in_dir, mains_dir);
toc
disp("Removed mains")
% ~19 seconds
% (6 seconds on R2023b)
%%
disp("HP filter... (High-pass filter)")
tic
hpFilter(mains_dir,out_dir,20000,settings.n_electrodes,settings.broken_channels);
toc
disp("HP filter done")
% ~7 seconds
% (5 seconds on R2023b)
%% GS: this preprocessed data is not used downstream
disp("Removing common...")
tic
removeCommon(settings.n_electrodes,settings.broken_channels,out_dir,common_dir);
toc
disp("Removed common")
% ~15 seconds
% (10 seconds on R2023b)
%% Plot preprocessed data
% GS: folder can be changed to any folder contain .sp files (to plot data
% from different preprocessing stages)
% Press key to advance plot to the next data segment.
disp("Plotting data...")
tic
plotData(out_dir,20000,settings.n_electrodes,settings.broken_channels);
toc
disp("Plotted data")
%% Localisation

% GS: this step is very slow!
% may also be memory issues (crashes MATLAB towards end using Stuart_E2 data)
% for example run, recommend changing line 56 loop from 1:max(loc) to 1:2
% or 1:3
disp("Reconstructing...")
tic
localised=Reconstruct(out_dir,settings);
toc
disp("Reconstructed")

stopsvfsvfdv

% ~30 min for first two locs on R2023b (shortened loop within function)
% very very slow on R2021a (possibly due to non-Intel chip on GS computer)
%% GS: export localised variable 
save([data_output_root '/localise_results.mat'],'localised','settings')
%%
disp("Firing frequency...")
tic
localised = firing_frequency(localised, 1);
localised=localised(~cellfun('isempty',localised));
toc
disp("Firing frequency done")



% R2023b: fraction of a second
%%
tic
needle=buildNeedleModel('nonlinear',settings.n_electrodes, settings.offset);
toc

% R2023b: fraction of a second
%% Plot locations of localised fibres (one colour per MU)
figure
scatter3(needle(:,1), needle(:,2), ones(length(needle),1), 's');
hold on
for n= 1:length(needle)
    text(needle(n,1)+0.05,needle(n,2)+0.1, num2str(n))
end
for MU = 1:length(localised)
    try
    fibre_centres = localised{MU}.fibre_centres;
    scatter3(fibre_centres(:,1),fibre_centres(:,2), ...
        ones(length(fibre_centres(:,1)),1).*localised{MU}.onsets','.')
    catch
        continue
    end
end
ylim([-2 2])
xlim([0 (settings.n_electrodes*settings.offset)+0.5])
savefig([data_output_root '/tornado.fig'])

%% Derived factors- NN distance, all pairs distance etc
data_root = data_output_root; % GS: need data_root variable for these scripts

mc_dist_kmc
savefig([data_output_root '/KMC_localisation.fig'])
% %display those factors
%disp_all_nn_cumsum

%% Play as audio
%multi_emg = load_all_EMG(common_dir, settings.n_electrodes, settings.broken_channels, [0 200000000000]);
%soundsc(multi_emg(40,:))

