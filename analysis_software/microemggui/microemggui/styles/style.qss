/* Titles */

SectionTitle{
    font-weight: bold;
    font-size: 20pt;
    min-height: 50;
    max-height: 50;
}

SubsectionTitle{
    font-weight: bold;
    font-size: 16pt;
}

/* Buttons */

LargePushButton {
    font-size: 20pt;
    background-color: white;
    border-style: none;
    min-width: 10em;
    padding: 6px;
    border-radius: 10px;
}

LargePushButton:pressed {
    background-color: grey;
}
/* Settings input widgets - main section */

CheckBoxMain {
    font-weight: bold;
    font-size: 14pt;
    min-height: 35;
    max-height: 35;
}

/* Settings input widgets */

InputLabel {
    qproperty-alignment: 'AlignBottom | AlignLeft';
    min-height: 20;
    max-height: 20;
}

InputInlineLabel {
}

InputInlineText {
    color: 'grey';
}

InputWarningLabel {
    color: 'red';
    font-size: 12pt;
}

InputComboBox {
    min-width: 150;
    max-width: 150;
}

InputSpinBox {
    min-width: 100;
    max-width: 100;
}

InputLineEdit {
    min-width: 50;
    max-width: 50;
}

QPushButton {
    min-width: 50;
    max-width: 50;
}

