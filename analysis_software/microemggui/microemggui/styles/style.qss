/* Titles */

SectionTitle{
    font-weight: bold;
    font-size: 20pt;
    min-height: 30;
    max-height: 30;
    qproperty-alignment: 'AlignTop | AlignLeft';
    color: {clr_text_dark};
}

SubsectionTitle{
    font-weight: bold;
    font-size: 16pt;
    qproperty-alignment: 'AlignTop | AlignLeft';
    color: {clr_text_dark};
}

TitleInputLabel {
    font-weight: bold;
    font-size: 16pt;
    color: {clr_text_dark};
}

/* Buttons */

SmallPushButton {
    font-size: 12pt;
    color: {clr_accent};
    background-color: {clr_small_button};
    border-style: solid;
    border-width: 1px;
    border-color: {clr_accent};
    padding: 4;
    width: 100px;
    border-radius: {radius_button};
}

SmallPushButton:hover, MotorUnitButton:hover {
    color: {clr_large_button_text};
    border-color: {clr_accent};
    background-color: {clr_accent};
}

SmallPushButton:pressed, MotorUnitButton:pressed {
    color: {clr_large_button_text};
    border-color: {clr_accent_pressed};
    background-color: {clr_accent_pressed};
}

SmallPushButton:disabled, MotorUnitButton:disabled {
    color: {clr_accent_disabled};
    border-color: {clr_accent_disabled};
}

LargePushButton {
    font-size: 16pt;
    color: {clr_large_button_text};
    background-color: {clr_accent};
    border: none;
    padding: 4;
    width: 100px;
    border-radius: {radius_button};
}

LargePushButton:hover {
    background-color: {clr_accent_hover};
}

LargePushButton:pressed {
    background-color: {clr_accent_pressed};
}

LargePushButton:disabled {
    background-color: {clr_accent_disabled};
}

TabButton {
    font-size: 12pt;
    border-style: solid;
    border-width: 1px;
    border-color: {clr_small_button_border};
    padding: 4;
    width: 150px;
    border-radius: {radius_button};
}

TabButton:disabled {
    background-color: 'white';
    font-weight: bold;
    color: 'black';
    font-size: 12pt;
    border-style: solid;
    border-width: 1px;
    border-color: {clr_small_button_border};
    padding: 4;
    width: 150px;
    border-radius: {radius_button};
}

WidgetControlButton {
    background-color: 'white';
    border-style: solid;
    border-width: 1px;
    border-color: {clr_small_button_border};
    border-radius: {radius_button};
    padding: 3;
}

WidgetControlButton:pressed {
    background-color: #D9D9D9;
}

WidgetControlButton:disabled {
    background-color: #D9D9D9;
}

MotorUnitButton {
    font-size: 12pt;
    background-color: {clr_small_button};
    border-style: solid;
    border-width: 1px;
    border-color: {clr_accent};
    color: {clr_accent};
    padding: 4;
    width: 80px;
    border-radius: {radius_button};
}

MotorUnitButton:checked {
    background-color: {clr_accent};
    color: {clr_large_button_text};
}

/* Toolbars and toolbar widgets */

TopToolbar {
    padding: 5px;
    background: 'white';
    border-left: none;
    border-top: none;
    border-bottom: 1px solid {clr_border_light};
    border-right: none;
}

AnalysisToolbar {
    background: 'white';
    border-left: none;
    border-top: none;
    border-bottom: none;
    border-right: 1px solid {clr_border};
    spacing: 0px;
}

AnalysisToolbarButton {
    font-size: 14pt;
    text-align: left;
    background-color: 'white';
    border-left: none;
    border-top: none;
    border-bottom: none;
    border-right: 1px solid {clr_border};
    padding: 10px;
    width: 135px;
    border-radius: 0;
}

AnalysisToolbarButton:hover {
    background-color: #D9D9D9;
}

AnalysisToolbarButton:checked {
    background-color: {clr_accent};
    color: {clr_large_button_text};
}

AnalysisToolbarButton:disabled {
    color: #D9D9D9;
}

AnalysisToolbarLabel {
    color: {clr_text_light};
    font-weight: bold;
    font-size: 12pt;
    padding-left: 5px;
    padding-top: 20px;
    padding-bottom: 5px;
}

RecordingLabel {
    color: {clr_text_light};
    font-size: 12pt;
}

MicroEMGLogo {
    text-align: center;
    background-color: 'white';
    border-left: none;
    border-top: none;
    border-bottom: none;
    border-right: 1px solid {clr_border};
    padding-left: 10px;
    padding-top: 0px;
    padding-right: 10px;
    padding-bottom: 0px;
    width: 135px;
    qproperty-iconSize: 100px;
    border-radius: 0;
}

MicroEMGLogo:hover {
    background-color: #D9D9D9;
}

MicroEMGLogo:checked {
    background-color: {clr_accent};
}

/* Settings input widgets - main section */

CheckBoxMain {
    font-weight: bold;
    font-size: 14pt;
    min-height: 35;
    max-height: 35;
    color: {clr_text_medium};
}

/* Settings input widgets */

CheckBoxChannel {
    font-size: 12pt;
    font-weight: bold;
    min-height: 18px;
    max-height: 40px;
}

CheckBoxChannel::indicator {
    width: 14px;
    height: 14px;
}

CheckBoxChannel::indicator:checked {
    background-color: {clr_accent};
    border: 1px solid {clr_border_light};
}

CheckBoxChannel::indicator:unchecked {
    background-color: white;
    border: 1px solid {clr_border_light};
}

CheckBoxChannel::indicator:checked {
    image: url(none);
}

CheckBoxChannel::indicator:checked {
    background-color: white;
    border: 1px solid {clr_border_light};
    image: url(:/bootstrap/check)
}

CheckBoxChannelLabel {
    font-size: 12pt;
    font-weight: bold;
    min-height: 20;
    max-height: 20;
    padding: 0;
}

InputLabel {
    qproperty-alignment: 'AlignBottom | AlignLeft';
    min-height: 20;
    max-height: 20;
    font-weight: bold;
    color: {clr_text_medium};
}

InputInlineLabel {
    font-weight: bold;
    color: {clr_text_medium};
}

InputInlineText {
    color: {clr_text_light};
}

InputExplanationLabel {
    color: {clr_text_light};
}

InputInlineHighlightedText {
    color: {clr_accent_dark};
    min-height: 20;
    max-height: 20;
}

HighlightedLabel {
    color: {clr_accent_dark};
}

HighlightedLabel#channels_widget_exclude {
    qproperty-alignment: 'AlignBottom | AlignLeft';
    min-height: 100;
    max-height: 100;
    min-width: 250;
    max-width: 250;
    color: {clr_accent_dark};
}

HighlightedLabel#select_mu_widget_message {
    qproperty-alignment: 'AlignBottom | AlignLeft';
    min-height: 100;
    max-height: 100;
    min-width: 175;
    max-width: 175;
    color: {clr_accent_dark};
}

InputWarningLabel {
    color: {clr_warning};
    font-size: 12pt;
}

InputComboBox {
    min-width: 150;
    max-width: 150;
}

InputSpinBox {
    min-width: 100;
    max-width: 100;
}

InputLineEdit {
    min-width: 50;
    max-width: 50;
}

QPushButton {
    min-width: 50;
    max-width: 50;
}

/* Misc settings for specific widgets */

/* EMG viewer */

EMGViewerWidget {
    background: white;
    border: 1px solid {clr_border};
    border-radius: 4px;
}

QLabel#amp{
    min-height: 25;
    max-height: 25;
    min-width: 25;
    max-width: 25;
}

/* Settings - set width */
PreprocSettingsWidget, LocaliseSettingsWidget {
    min-width: 250;
    max-width: 250;
}

ChannelsCheckBoxes {
    min-width: 220;
    max-width: 220;
}

/* Background and border for visualisations */
QTabWidget#muvistab::pane, QTabWidget#mufibretab::pane {
    background: white;
    padding: 10px;
    border: 1px solid {clr_border};
    border-radius: 4px;
}

/* Misc */

